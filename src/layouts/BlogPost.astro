---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import TagPill from '../components/TagPill.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { title, description, date, tags = [], cover, coverAlt } = Astro.props;

const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description} article image={cover?.src}>
  <Nav>
    <a href="/blog" class="transition hover:text-ink-50">← All posts</a>
    <a href="/explore" class="hidden transition hover:text-ink-50 sm:inline">Explore</a>
  </Nav>

  <article class="mx-auto max-w-2xl px-6 py-14">
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 text-sm text-ink-500">
        <time datetime={date.toISOString()}>{dateStr}</time>
      </div>
      <h1
        class="mt-3 font-display text-[length:var(--text-title)] leading-tight font-bold text-ink-50"
      >
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-300">{description}</p>
      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {tags.map((t) => (
              <TagPill tag={t} href={`/blog?tag=${encodeURIComponent(t)}`} />
            ))}
          </div>
        )
      }
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 1280]}
          sizes="(max-width: 672px) 100vw, 640px"
          class="mb-10 aspect-[16/9] w-full rounded-2xl border border-white/10 object-cover"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    <footer class="mt-14 border-t border-white/10 pt-6">
      <a href="/blog" class="text-sm text-cosmic-300 transition hover:text-cosmic-400">
        ← Back to all posts
      </a>
    </footer>
  </article>
</Base>
