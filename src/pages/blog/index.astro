---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog" description="Writing about AI, space, and things I'm building.">
  <Nav>
    <a href="/explore" class="transition hover:text-ink-50">← Explore</a>
  </Nav>

  <main class="mx-auto max-w-5xl px-6 py-14">
    <Reveal>
      <SectionHeading eyebrow="Transmissions" title="Blog" />
      <p class="-mt-4 mb-8 max-w-xl text-ink-300">
        Half-formed thoughts about AI, space, and whatever I'm building. Filter
        by tag to narrow the signal.
      </p>
    </Reveal>

    <!-- Tag filter -->
    <div
      id="tag-filter"
      class="mb-8 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter posts by tag"
    >
      <button
        type="button"
        data-tag="all"
        class="tag-btn rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-sm text-ink-300 transition hover:text-ink-50 aria-pressed:border-cosmic-400/60 aria-pressed:bg-cosmic-500/10 aria-pressed:text-cosmic-300"
        aria-pressed="true"
      >
        All
      </button>
      {
        allTags.map((tag) => (
          <button
            type="button"
            data-tag={tag}
            class="tag-btn rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-sm text-ink-300 transition hover:text-ink-50 aria-pressed:border-cosmic-400/60 aria-pressed:bg-cosmic-500/10 aria-pressed:text-cosmic-300"
            aria-pressed="false"
          >
            #{tag}
          </button>
        ))
      }
    </div>

    <!-- Posts grid -->
    <div id="post-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, i) => (
          <Reveal delay={i * 50} class="post-item h-full" data-tags={post.data.tags.join(',')}>
            <PostCard
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              cover={post.data.cover}
              coverAlt={post.data.coverAlt}
            />
          </Reveal>
        ))
      }
    </div>

    <p id="empty-state" class="hidden py-16 text-center text-ink-400">
      No posts with that tag yet. 🛰️
    </p>
  </main>

  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tag-btn')];
    const items = [...document.querySelectorAll<HTMLElement>('.post-item')];
    const emptyState = document.getElementById('empty-state');

    function apply(tag: string, push: boolean) {
      let visible = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags || '').split(',').filter(Boolean);
        const show = tag === 'all' || tags.includes(tag);
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.tag === tag)),
      );
      emptyState?.classList.toggle('hidden', visible !== 0);

      if (push) {
        const url = new URL(location.href);
        if (tag === 'all') url.searchParams.delete('tag');
        else url.searchParams.set('tag', tag);
        history.pushState({ tag }, '', url);
      }
    }

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => apply(btn.dataset.tag || 'all', true)),
    );

    // Sync with ?tag= on load and on back/forward.
    const initial = new URL(location.href).searchParams.get('tag');
    if (initial && buttons.some((b) => b.dataset.tag === initial)) {
      apply(initial, false);
    }
    window.addEventListener('popstate', () => {
      const tag = new URL(location.href).searchParams.get('tag') || 'all';
      apply(buttons.some((b) => b.dataset.tag === tag) ? tag : 'all', false);
    });
  </script>
</Base>
