---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import PostCard from '../components/PostCard.astro';
import HobbiesGallery from '../components/HobbiesGallery.astro';
import { PROFILE, LINKS } from '../config';

const latestPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  title="Explore"
  description="The personal wing — who I am, what I write, and the things I make for fun."
>
  <Nav>
    <a href="/blog" class="transition hover:text-ink-50">Blog</a>
    <a href="#hobbies" class="hidden transition hover:text-ink-50 sm:inline">Hobbies</a>
    <a
      href="/recruiter"
      class="rounded-lg border border-white/15 px-3 py-1.5 font-medium text-ink-50 transition hover:border-nebula-400/60 hover:text-nebula-300"
    >
      Recruiter mode
    </a>
  </Nav>

  <main class="mx-auto max-w-5xl px-6">
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="py-20 sm:py-28">
      <Reveal>
        <p class="mb-4 text-sm uppercase tracking-[0.35em] text-cosmic-300/80">
          You chose to orbit
        </p>
        <h1
          class="text-gradient font-display text-[length:var(--text-hero)] leading-[var(--text-hero--line-height)] font-bold"
        >
          Hey, I'm Ruhi.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-300">
          Welcome to the non-corporate wing. This is where I keep the things that
          don't fit on a résumé — writing, renders, photos, and the occasional
          overambitious side project.
        </p>
      </Reveal>
    </section>

    <!-- ── Who am I ─────────────────────────────────────────── -->
    <section id="about" class="scroll-mt-20 py-12">
      <Reveal>
        <SectionHeading eyebrow="Coordinates" title="Who am I" />
      </Reveal>
      <div class="grid gap-6 md:grid-cols-3">
        <Reveal class="md:col-span-2">
          <div class="space-y-4 text-ink-200">
            <p>
              I'm a CS student at Rutgers (Class of 2027) with a Business
              Administration minor, which mostly means I like building
              things <em>and</em> arguing about why they should exist.
            </p>
            <p>
              Lately I've been deep in AI tooling and space-adjacent software —
              multi-agent LLM systems, satellite simulation, and anything that
              lets me point a computer at a hard problem and see what happens.
            </p>
            <p>
              Off-screen you'll find me in Blender, behind a camera, making art,
              or negotiating with houseplants. This corner of the site is for all
              of that.
            </p>
          </div>
        </Reveal>
        <Reveal delay={80}>
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-cosmic-300/90">
              Currently
            </h3>
            <ul class="mt-3 space-y-3 text-sm text-ink-200">
              <li>🛰️ Building satellite + AI tooling</li>
              <li>📚 Studying at Rutgers</li>
              <li>🎨 Rendering things in Blender</li>
              <li>🌱 Keeping plants alive (mostly)</li>
            </ul>
            <a
              href={LINKS.github}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-block text-sm text-cosmic-300 transition hover:text-cosmic-400"
            >
              See what I'm coding →
            </a>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- ── Latest posts ─────────────────────────────────────── -->
    <section id="writing" class="scroll-mt-20 py-12">
      <Reveal>
        <div class="mb-8 flex items-end justify-between gap-4">
          <SectionHeading eyebrow="From the blog" title="Latest transmissions" class="mb-0" />
          <a
            href="/blog"
            class="shrink-0 text-sm text-cosmic-300 transition hover:text-cosmic-400"
          >
            All posts →
          </a>
        </div>
      </Reveal>
      {
        latestPosts.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {latestPosts.map((post, i) => (
              <Reveal delay={i * 60} class="h-full">
                <PostCard
                  href={`/blog/${post.id}`}
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  tags={post.data.tags}
                  cover={post.data.cover}
                  coverAlt={post.data.coverAlt}
                />
              </Reveal>
            ))}
          </div>
        ) : (
          <p class="text-ink-400">No posts yet — check back soon.</p>
        )
      }
    </section>

    <!-- ── Hobbies gallery ──────────────────────────────────── -->
    <section id="hobbies" class="scroll-mt-20 py-12">
      <Reveal>
        <SectionHeading eyebrow="For fun" title="Hobbies" />
        <p class="-mt-4 mb-6 max-w-xl text-ink-300">
          Blender renders, art, photography, and gardening. Filter by category;
          click anything to open it.
        </p>
      </Reveal>
      <Reveal>
        <HobbiesGallery />
      </Reveal>
    </section>

    <!-- ══════════════════════════════════════════════════════
         PLACEHOLDER SECTION — add a "now" page, playlists, book
         shelf, or anything personal. Delete when unused.
         ══════════════════════════════════════════════════════ -->
    <section id="more" class="scroll-mt-20 py-12 pb-20">
      <Reveal>
        <div
          class="rounded-2xl border border-dashed border-white/15 bg-white/[0.02] p-8 text-center"
        >
          <p class="text-sm uppercase tracking-[0.3em] text-ink-500">
            Uncharted space
          </p>
          <p class="mt-3 text-ink-300">
            Room for whatever I feel like adding next.
          </p>
        </div>
      </Reveal>
    </section>
  </main>
</Base>
