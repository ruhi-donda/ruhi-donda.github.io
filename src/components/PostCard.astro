---
import { Image } from 'astro:assets';
import TagPill from './TagPill.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { href, title, description, date, tags = [], cover, coverAlt } = Astro.props;

const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Deterministic on-theme gradient so cover-less posts still look distinct.
let hash = 0;
for (const ch of title) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const hue = hash % 360;
const gradient = `linear-gradient(135deg, hsl(${hue} 70% 22%), hsl(${(hue + 55) % 360} 65% 12%))`;
---

<a
  href={href}
  data-tags={tags.join(',')}
  class="post-card group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition duration-300 hover:-translate-y-1 hover:border-cosmic-400/40 hover:shadow-[0_18px_50px_-24px_rgba(56,189,248,0.45)]"
>
  <div class="relative aspect-[16/9] overflow-hidden">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, 400px"
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="h-full w-full" style={`background:${gradient}`}>
          <div
            class="flex h-full w-full items-center justify-center"
            style="background:radial-gradient(circle at 30% 25%, rgba(255,255,255,0.10), transparent 55%)"
          >
            <span class="font-display text-4xl opacity-30" aria-hidden="true">✦</span>
          </div>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <time datetime={date.toISOString()} class="text-xs uppercase tracking-wider text-ink-500">
      {dateStr}
    </time>
    <h3 class="mt-2 font-display text-lg font-semibold text-ink-50 transition group-hover:text-cosmic-300">
      {title}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-300">{description}</p>
    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <TagPill tag={t} />
          ))}
        </div>
      )
    }
  </div>
</a>
