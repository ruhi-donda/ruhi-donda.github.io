---
// Server-side wrapper: loads the hobbies collection, optimizes every image with
// Astro's image tooling (getImage), and hands plain URLs to the React island.
// This keeps image optimization at build time while the interactive grid,
// filtering, and lightbox run client-side.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Gallery from './react/Gallery.tsx';

const entries = (await getCollection('hobbies')).sort((a, b) => {
  const d = (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0);
  return d !== 0 ? d : a.data.order - b.data.order;
});

const items = await Promise.all(
  entries.map(async (entry) => {
    const base = {
      id: entry.id,
      title: entry.data.title,
      category: entry.data.category,
      type: entry.data.type,
    };

    if (entry.data.type === 'image' && entry.data.image) {
      const thumb = await getImage({
        src: entry.data.image,
        widths: [400, 800],
        format: 'webp',
      });
      const full = await getImage({
        src: entry.data.image,
        width: 1600,
        format: 'webp',
      });
      return {
        ...base,
        alt: entry.data.alt ?? entry.data.title,
        thumbSrc: thumb.src,
        thumbSrcset: thumb.srcSet.attribute,
        fullSrc: full.src,
        width: entry.data.image.width,
        height: entry.data.image.height,
      };
    }

    // Video entry — optional optimized poster/thumbnail.
    let thumbSrc: string | undefined;
    if (entry.data.thumb) {
      const t = await getImage({ src: entry.data.thumb, widths: [400, 800], format: 'webp' });
      thumbSrc = t.src;
    }
    return {
      ...base,
      alt: entry.data.alt ?? entry.data.title,
      provider: entry.data.provider,
      videoId: entry.data.videoId,
      thumbSrc,
    };
  }),
);

const categories = [...new Set(items.map((i) => i.category))];
---

<Gallery client:visible items={items} categories={categories} />
