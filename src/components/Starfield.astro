---
// Canvas starfield for the fixed backdrop. Draws layered stars with a slow
// drift + gentle twinkle and a subtle scroll parallax. If the visitor prefers
// reduced motion (or JS is unavailable), it renders a single static frame and
// never animates.
---

<canvas
  id="starfield"
  class="absolute inset-0 h-full w-full"
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    type Star = {
      x: number;
      y: number;
      r: number;
      base: number; // base opacity
      tw: number; // twinkle speed
      ph: number; // twinkle phase
      depth: number; // parallax factor
      hue: string;
    };

    let stars: Star[] = [];
    let w = 0;
    let h = 0;
    let scrollY = window.scrollY;

    const HUES = ['255,255,255', '196,181,253', '125,211,252', '253,230,138'];

    function build() {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Density scales with area but is capped for performance.
      const count = Math.min(220, Math.floor((w * h) / 9000));
      stars = Array.from({ length: count }, () => {
        const depth = Math.random();
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          r: depth * 1.3 + 0.3,
          base: depth * 0.5 + 0.25,
          tw: Math.random() * 0.9 + 0.2,
          ph: Math.random() * Math.PI * 2,
          depth,
          hue: HUES[Math.floor(Math.random() * (Math.random() < 0.85 ? 1 : HUES.length))],
        };
      });
    }

    function draw(t: number) {
      ctx.clearRect(0, 0, w, h);
      const parallax = (scrollY * 0.04);
      for (const s of stars) {
        const twinkle = reduce ? 1 : 0.65 + 0.35 * Math.sin(t * 0.001 * s.tw + s.ph);
        const y = ((s.y - parallax * s.depth) % h + h) % h;
        ctx.beginPath();
        ctx.arc(s.x, y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${s.hue},${(s.base * twinkle).toFixed(3)})`;
        ctx.fill();
      }
    }

    let raf = 0;
    function loop(t: number) {
      draw(t);
      raf = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(raf);
      if (reduce) draw(0);
      else raf = requestAnimationFrame(loop);
    }

    build();
    start();

    // Parallax follows scroll (cheap: just updates a number the loop reads).
    if (!reduce) {
      window.addEventListener(
        'scroll',
        () => { scrollY = window.scrollY; },
        { passive: true },
      );
      // Pause when the tab is hidden to save battery.
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(loop);
      });
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        if (reduce) draw(0);
      }, 200);
    });
  }
</script>
