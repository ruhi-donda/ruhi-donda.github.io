---
interface Props {
  tag: string;
  href?: string;
  class?: string;
}
const { tag, href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-block rounded-full border border-white/10 bg-space-800/60 px-2.5 py-0.5 text-xs text-ink-300 transition',
    href && 'hover:border-cosmic-400/50 hover:text-cosmic-300',
    className,
  ]}
>
  #{tag}
</Tag>
