---
interface Props {
  title: string;
  summary: string;
  stack?: string[];
  repo?: string;
  demo?: string;
  writeup?: boolean;
}
const { title, summary, stack = [], repo, demo, writeup = false } = Astro.props;
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:-translate-y-1 hover:border-nebula-400/50 hover:bg-white/[0.05] hover:shadow-[0_18px_50px_-20px_rgba(139,92,246,0.5)]"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-xl font-semibold text-ink-50">{title}</h3>
    {
      writeup && (
        <span class="shrink-0 rounded-full border border-star-300/30 bg-star-300/10 px-2.5 py-0.5 text-[0.7rem] font-medium text-star-300">
          Write-up
        </span>
      )
    }
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-300">{summary}</p>

  {
    stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech stack">
        {stack.map((tech) => (
          <li class="rounded-md border border-white/10 bg-space-800/60 px-2 py-0.5 text-xs text-ink-300">
            {tech}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-5 flex flex-wrap items-center gap-4 text-sm">
    {
      repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 font-medium text-cosmic-300 transition hover:text-cosmic-400"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          Code
        </a>
      )
    }
    {
      demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 font-medium text-cosmic-300 transition hover:text-cosmic-400"
        >
          Live demo
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>
